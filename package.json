            "dompurify@<3.4.17": "3.4.17",
            "fast-uri@<3.1.7": "3.1.7",
            "fast-xml-builder@<1.1.7": "1.1.7",
            "fast-xml-parser@4": "4.5.5",
            "fast-xml-parser@5": "5.5.6",
            "follow-redirects@<1.16.2": "1.16.2",
            "handlebars@<4.7.10": "4.7.10",
            "hono@<4.12.25": "4.12.25",
            "immutable@4": "4.3.9",
            "ip-address@<10.3.1": "10.3.1",
            "js-yaml@4": "4.3.2",
            "jsondiffpatch@<0.7.6": "0.7.6",
            "jws@3": "3.2.3",
            "jws@4": "4.0.1",
            "langchain@0.3": "0.3.37",
            "langsmith@<0.6.0": "0.6.0",
            "linkify-it@<5.0.2": "5.0.2",
            "lodash@<4.18.0": "4.18.0",
            "lodash-es@<4.18.0": "4.18.0",
            "markdown-it@<14.3.3": "14.3.3",
            "mysql2@<3.22.0": "3.22.0",
            "nanoid@3": "3.3.18",
            "nodemailer@<10.0.6": "10.0.6",
            "picomatch@2": "2.3.2",
            "picomatch@4": "4.0.4",
            "playwright@<1.55.1": "1.55.1",
            "playwright-core@<1.55.1": "1.55.1",
            "postcss@<8.5.18": "8.5.18",
            "prosemirror-view@<1.42.3": "1.42.3",
            "proxy-addr@<2.0.8": "2.0.8",
            "seroval@<1.6.8": "1.6.8",
            "sharp@<0.35.5": "0.35.5",
            "source-map-js@<1.2.2": "1.2.2",
            "tar@<7.5.21": "7.5.21",
            "underscore@<1.13.8": "1.13.8",
            "undici@6": "6.29.1",
            "undici@7": "7.30.1",
            "validator@<13.15.22": "13.15.22",
            "vite@4": "6.4.4",
            "vm2@<3.12.2": "3.12.2",
            "pdf2json@3": "3.2.2",
            "vite@6>esbuild": "0.28.2"
        }
    },
    "engines": {
        "node": "^24",
        "pnpm": "^10.26.0"
    },
    "resolutions": {
        "@anthropic-ai/sdk": "^0.73.0",
        "@google/generative-ai": "^0.24.0",
        "@grpc/grpc-js": "^1.10.10",
        "@langchain/core": "1.1.20",
        "@qdrant/openapi-typescript-fetch": "1.2.6",
        "openai": "6.19.0",
        "protobufjs": "7.5.5",
        "uuid": "^10.0.0"
    },
    "eslintIgnore": [
        "**/dist",
        "**/node_modules",
        "**/build",
        "**/package-lock.json"
    ],
    "prettier": {
        "printWidth": 140,
        "singleQuote": true,
        "jsxSingleQuote": true,
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "endOfLine": "auto"
    },
    "babel": {
        "presets": [
            "@babel/preset-typescript",
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    }
}
